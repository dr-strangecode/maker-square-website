---
import { brand } from "../config/site";
import LocationAddress from "./LocationAddress.astro";
const footerNav = [
  {href:"/hours",label:"Plan your visit"}, {href:"/memberships",label:"Memberships"}, {href:"/parties",label:"Birthday parties"}, {href:"/events",label:"Events"}, {href:"/gallery",label:"Gallery"}, {href:"/rules",label:"Rules & waiver"}, {href:"/contact",label:"Contact"}
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <strong>{brand.name}</strong>
      <LocationAddress compact />
      <p>
        <a href={`mailto:${brand.email}`}>{brand.email}</a><br />
        <a href={`tel:${brand.phoneTel}`}>{brand.phoneDisplay}</a>
      </p>
      <p class="fine">{brand.footerLegal}</p>
    </div>
    <div>
      <strong>Visit</strong>
      <p>
        {footerNav.map((item) => (
          <>
            <a href={item.href}>{item.label}</a>
            <br />
          </>
        ))}
      </p>
    </div>
    <div>
      <strong>Hours</strong>
      <p>
        {brand.hours.map((entry) => <>{entry.day}: {entry.time}<br /></>)}
      </p>
      {(brand.facebook || brand.instagram) && (
        <p>
          {brand.facebook && <><a href={brand.facebook} target="_blank" rel="noopener noreferrer">Facebook</a><br /></>}
          {brand.instagram && <a href={brand.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>}
        </p>
      )}
    </div>
  </div>
</footer>
