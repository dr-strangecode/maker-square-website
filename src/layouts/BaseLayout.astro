---
import '../styles/global.css';
import '../styles/playtown.css';
import '../styles/playtown-responsive.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand, brandId } from '../config/site';
interface Props { title: string; description?: string; }
const { title, description = `${brand.name} — indoor play at the Mall at Johnson City, Suite E3C.` } = Astro.props;
const pageTitle = title.includes(brand.titleSuffix) ? title : `${title} · ${brand.titleSuffix}`;
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{pageTitle}</title><meta name="description" content={description}/>
  <meta name="theme-color" content={brandId === 'maker' ? '#dff7ff' : '#5d6b52'}/>
  <link rel="icon" href={brand.logoSrc} type="image/png"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Forum&family=Fredoka:wght@500;600;700&family=Lilita+One&family=Nunito:wght@400;600;700;800;900&family=Source+Sans+3:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet"/>
  <style is:global>.skip-link{position:fixed;top:-100px;left:16px;z-index:1000;background:#fff;color:#092e50;padding:12px 20px;border:3px solid #092e50;border-radius:8px}.skip-link:focus{top:12px}</style>
 </head>
 <body class={`skin-${brandId}`}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header/>
  <main id="main-content" tabindex="-1"><slot/></main>
  <Footer/>
  {brandId === 'maker' ? (
   <><script is:inline src="/js/playtown.js" defer></script><noscript><style is:inline>.ms-mobile-menu[hidden]{display:grid!important}.ms-menu-button{display:none!important}</style></noscript></>
  ) : (
   <script is:inline>
    const header = document.querySelector('.site-header');
    const btn = document.querySelector('.nav-toggle');
    btn?.addEventListener('click', () => {
      header?.classList.toggle('open');
      btn.setAttribute('aria-expanded', header?.classList.contains('open') ? 'true' : 'false');
    });
   </script>
  )}
 </body>
</html>
