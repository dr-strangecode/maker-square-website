---
import BaseLayout from '../layouts/BaseLayout.astro';
import { brand } from '../config/site';
---
<BaseLayout title="Our story" description={`Get to know ${brand.name}, a welcoming play place for families in Johnson City.`}>
 <section class="section"><div class="wrap narrow"><p class="eyebrow">More than play</p><h1>A little town of big possibilities</h1><p class="lede">Maker Square is growing into a place for little imaginations and the grown-ups who love them.</p><p>We’re bringing a new name and a new vision to the play space at the Mall at Johnson City. As we make changes, our focus is on imaginative play, thoughtful spaces and a welcoming experience for families.</p><p>Visit our gallery for photographs of the current space, or get in touch to ask what’s new before you come.</p><div class="actions"><a class="btn" href="/gallery">See the current play space</a><a class="btn ghost" href="/hours">Plan your visit</a><a class="btn ghost" href="/contact">Say hello</a></div></div></section>
</BaseLayout>
