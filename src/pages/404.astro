---
import BaseLayout from "../layouts/BaseLayout.astro";
import { brand } from "../config/site";
---

<BaseLayout title="Page not found">
  <section class="section">
    <div class="wrap narrow">
      <p class="eyebrow">{brand.name}</p>
      <h1>We couldn’t find that page</h1>
      <p>
        The old shop and gift-card links don’t live here anymore.
        Home, hours, parties, and contact are the pages to try.
      </p>
      <div class="actions">
        <a class="btn" href="/">Home</a>
        <a class="btn ghost" href="/hours">Hours</a>
        <a class="btn ghost" href="/parties">Parties</a>
        <a class="btn ghost" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
